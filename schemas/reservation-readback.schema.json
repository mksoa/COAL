{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COAL readback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reason",
    "observed_sha",
    "causal_authorship_proven",
    "receipt"
  ],
  "properties": {
    "status": {
      "enum": [
        "PRESENT_MATCH",
        "ABSENT_OBSERVED",
        "DIVERGENT",
        "UNKNOWN"
      ]
    },
    "reason": {
      "type": "string"
    },
    "observed_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "causal_authorship_proven": {
      "const": false
    },
    "receipt": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
