{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COAL receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "request_id",
    "http_status",
    "body_b64",
    "body_sha256",
    "body_withheld",
    "native_ref",
    "observed_at",
    "issuer",
    "reconciliation",
    "error",
    "receipt_digest"
  ],
  "properties": {
    "operation": {
      "enum": [
        "create",
        "read"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ]
    },
    "body_b64": {
      "type": [
        "string",
        "null"
      ]
    },
    "body_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "body_withheld": {
      "type": "boolean"
    },
    "native_ref": {
      "type": "string",
      "pattern": "^refs/coal/attempts/[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "string"
    },
    "issuer": {
      "type": [
        "string",
        "null"
      ]
    },
    "reconciliation": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
