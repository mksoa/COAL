{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COAL W038 checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "epoch",
    "frontier",
    "digest"
  ],
  "properties": {
    "epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "frontier": {
      "type": "integer",
      "minimum": 0
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
